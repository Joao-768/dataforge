# DataForge configuration. Copy to .env for local development
# (`npm run setup` does it for you and generates the encryption key).
# Docker Compose reads the same file; values here override its defaults.

# Public URL of the app. Used for links in emails and the CSRF origin check.
APP_URL=http://localhost:3300

# Application database (users, projects, encrypted credentials, history).
# Local dev talks to the Compose service published on 127.0.0.1:5436.
DATABASE_URL=postgres://dataforge:dataforge-local-only@127.0.0.1:5436/dataforge
APP_DB_PASSWORD=dataforge-local-only

# Target server that hosts sandbox and demo databases.
TARGET_DB_HOST=127.0.0.1
TARGET_DB_PORT=5437
TARGET_DB_PROVISIONER_USER=dataforge_provisioner
TARGET_DB_PROVISIONER_PASSWORD=provisioner-local-only
TARGET_DB_SUPERUSER_PASSWORD=target-superuser-local-only
# TLS to the target server: disable, require or verify-full. Use verify-full
# for a managed server (Neon, for example) reached over the internet.
TARGET_DB_SSL=disable

# 32 random bytes, base64. Encrypts saved database passwords. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# When empty, a key is generated into DATAFORGE_KEY_FILE on first start.
DATAFORGE_ENCRYPTION_KEY=
DATAFORGE_KEY_FILE=.data/encryption.key

# Outgoing mail. Compose runs Mailpit (inbox at http://localhost:8025).
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=DataForge <no-reply@dataforge.local>

# External PostgreSQL connections: "disabled" or "allowlist". With
# "allowlist", only hosts listed here may be used (hostnames, *.domain
# wildcards, IPs or CIDR ranges). Private and metadata addresses stay blocked
# unless a CIDR entry covers them explicitly.
EXTERNAL_CONNECTIONS=disabled
EXTERNAL_HOST_ALLOWLIST=

# Public demo: one private sandbox per visitor, removed after DEMO_TTL_HOURS.
DEMO_ENABLED=true
DEMO_TTL_HOURS=24
DEMO_MAX_ACTIVE=40
# Demos one client address may start per hour.
DEMO_STARTS_PER_HOUR=6

# Sandbox limits.
SANDBOX_MAX_PER_USER=3
SANDBOX_MAX_TOTAL=200
SANDBOX_MAX_SIZE_MB=100

# Query limits.
QUERY_TIMEOUT_MS=15000
QUERY_MAX_ROWS=1000
IMPORT_MAX_BYTES=10485760

# Cookies are Secure automatically when APP_URL is https.
# SECURE_COOKIES=true
# Set when running behind a reverse proxy that appends X-Forwarded-For.
TRUST_PROXY=false

# Enables POST /api/cron/sweep, the housekeeping sweep for serverless hosts
# (Vercel). At least 32 characters, sent as "Authorization: Bearer <secret>".
# CRON_SECRET=

LOG_LEVEL=info
