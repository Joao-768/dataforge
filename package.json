{
    "name": "dataforge",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "postinstall": "node scripts/copy-monaco.mjs",
        "setup": "node scripts/setup-env.mjs",
        "services": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d app-db target-db mailpit",
        "services:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
        "dev": "next dev --port 3300",
        "build": "node scripts/copy-monaco.mjs && next build",
        "start": "next start --port 3300",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run --project unit --project components",
        "test:integration": "vitest run --project integration",
        "test:all": "vitest run",
        "test:e2e": "playwright test",
        "db:migrate": "tsx --conditions=react-server scripts/migrate.mts",
        "target:init": "node scripts/init-managed-target.mjs",
        "stack": "docker compose up --build -d"
    },
    "dependencies": {
        "@dagrejs/dagre": "^3.1.1",
        "@monaco-editor/react": "^4.7.0",
        "@tanstack/react-query": "^5.104.1",
        "@tanstack/react-table": "^8.21.3",
        "@tanstack/react-virtual": "^3.14.14",
        "@xyflow/react": "^12.12.0",
        "clsx": "^2.1.1",
        "csv-parse": "^7.0.3",
        "csv-stringify": "^6.9.0",
        "geist": "^1.7.2",
        "lucide-react": "^1.55.0",
        "monaco-editor": "^0.57.0",
        "next": "16.4.0",
        "nodemailer": "^10.1.0",
        "papaparse": "^5.7.0",
        "pg": "^8.23.1",
        "pg-cursor": "^2.22.1",
        "pino": "^10.4.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-resizable-panels": "^4.14.4",
        "server-only": "^0.0.1",
        "sql-formatter": "^15.9.0",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.5",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.0",
        "@tailwindcss/turbopack": "^4",
        "@testcontainers/postgresql": "^12.2.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^24.19.2",
        "@types/nodemailer": "^8.0.2",
        "@types/papaparse": "^5.5.2",
        "@types/pg": "^8.23.1",
        "@types/pg-cursor": "^2.7.2",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.1.2",
        "jsdom": "^29.1.1",
        "oxlint": "^1.87.0",
        "prettier": "^3.9.10",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "dompurify": "^3.4.16"
    }
}
